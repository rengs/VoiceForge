# Backend
VOICEFORGE_HOST=127.0.0.1
VOICEFORGE_PORT=8765
VOICEFORGE_ASR_MODEL=sensevoice
VOICEFORGE_ASR_DEVICE=cpu
VOICEFORGE_LANGUAGE=zh

# LLM: ollama | openai | disabled
VOICEFORGE_LLM_PROVIDER=ollama
VOICEFORGE_LLM_MODEL=qwen2.5:3b
VOICEFORGE_OLLAMA_URL=http://127.0.0.1:11434
VOICEFORGE_LLM_TIMEOUT_SECONDS=45
VOICEFORGE_LLM_MAX_TOKENS=512
VOICEFORGE_LLM_THINK=false
VOICEFORGE_LLM_KEEP_ALIVE=10m

# Global push-to-talk hotkey. Edit this file, then choose
# “重新加载快捷键” from the VoiceForge menu.
VOICEFORGE_HOTKEY=command+shift+space

# OpenAI-compatible provider (only used when provider=openai)
VOICEFORGE_OPENAI_BASE_URL=https://api.openai.com/v1
VOICEFORGE_OPENAI_API_KEY=
